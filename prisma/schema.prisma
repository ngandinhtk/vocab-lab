// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Grammar {
  id          Int      @id @default(autoincrement())
  title       String
  explanation String?
  examples    Json?    // Array of objects: [{ "ja": "...", "vi": "...", "en": "..." }]
  level       Int?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("grammar")
}

model Kanji {
  id        Int      @id @default(autoincrement())
  character String   @unique @db.Char(1)
  strokes   Int?
  meaning   String?
  onyomi    String?
  kunyomi   String?
  radical   String?
  level     Int?     @map("jlpt_level")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("kanji")
}

model Vocabulary {
  id              Int      @id @default(autoincrement())
  word            String
  reading         String?
  meaning         String
  level           Int?     @map("jlpt_level")
  exampleSentences Json?    @map("example_sentences") // Array of objects: [{ "ja": "...", "vi": "...", "en": "..." }]
  audioUrl        String?  @map("audio_url")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("vocabulary")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  level        Int?     @default(1)
  streak       Int?     @default(0)
  exp          Int?     @default(0)
  role         String?  @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  testResults  TestResult[]

  @@map("users")
}

model TestResult {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  level     Int
  score     Int
  total     Int
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("test_results")
}
